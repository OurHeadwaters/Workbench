modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/north-star: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:gated"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 BASE_PATH=/ pnpm --filter @workspace/mockup-sandbox run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "artifacts/north-star: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=9000 BASE_PATH=/north-star/ pnpm --filter @workspace/north-star run dev"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 360000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 9000
externalPort = 9000

[[ports]]
localPort = 20252
externalPort = 3002

[[ports]]
localPort = 20502
externalPort = 4200

[[ports]]
localPort = 20509
externalPort = 6000

[[ports]]
localPort = 20510
externalPort = 3001

[[ports]]
localPort = 20511
externalPort = 6800

[[ports]]
localPort = 21384
externalPort = 80

[[ports]]
localPort = 25432
externalPort = 5173

[[ports]]
localPort = 25433
externalPort = 5000

[[ports]]
localPort = 25674
externalPort = 3000

[[ports]]
localPort = 25703
externalPort = 3003

[nix]
channel = "stable-25_05"

