{
  "name": "@workspace/practitioner-operating-plan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "node scripts/generate-cashflow-xlsx.mjs && pnpm run check-slide-refs && vite build --config vite.config.ts",
    "postbuild": "pnpm run check",
    "build:cashflow-xlsx": "node scripts/generate-cashflow-xlsx.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run check-slide-refs",
    "check": "pnpm run typecheck && pnpm run validate-slides && pnpm run check-slide-refs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "validate-slides": "tsx scripts/validate-slides.ts",
    "check-slide-refs": "tsx scripts/check-slide-refs.ts"
  },
  "dependencies": {
    "@workspace/practitioners-guide-v2": "workspace:*",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "wouter": "catalog:"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@workspace/codetry-public": "workspace:*",
    "lucide-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^29.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "xlsx": "^0.18.5"
  }
}
