{
  "name": "@workspace/practitioner-operating-plan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./budgetMath": "./src/lib/budgetMath.ts",
    "./storage": "./src/lib/storage.ts",
    "./costRegistry": "./src/data/costRegistry.ts"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "BASE_PATH=\"${BASE_PATH:-/}\" PORT=\"${PORT:-5173}\" vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "postbuild": "SKIP_BUILD=1 pnpm exec tsx scripts/export-pdfs.ts",
    "validate-slides": "pnpm exec tsx scripts/validate-slides.ts",
    "check-slide-refs": "pnpm exec tsx scripts/check-slide-refs.ts",
    "check-corridor-defaults": "pnpm exec tsx scripts/check-corridor-defaults.ts",
    "check": "pnpm run validate-slides && pnpm run check-slide-refs && pnpm run check-corridor-defaults",
    "export-pdfs": "pnpm exec tsx scripts/export-pdfs.ts",
    "export-onepager-pdf": "pnpm exec tsx scripts/export-pdfs.ts",
    "export-checklist-pdf": "pnpm exec tsx scripts/export-pdfs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/cross-reserve-corridor": "workspace:*",
    "@workspace/headwaters-pricing": "workspace:*"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "^29.0.2",
    "puppeteer-core": "^24.42.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.5",
    "wouter": "catalog:",
    "zod": "catalog:"
  }
}
