{
  "name": "@workspace/deer-lake-store-plan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "validate-slides": "pnpm exec tsx scripts/validate-slides.ts",
    "check-corridor-defaults": "pnpm exec tsx scripts/check-corridor-defaults.ts",
    "check": "pnpm run validate-slides && pnpm run check-corridor-defaults",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/cross-reserve-corridor": "workspace:*",
    "@workspace/headwaters-pricing": "workspace:*",
    "@workspace/practitioner-operating-plan": "workspace:*",
    "@workspace/why-stores-fail": "workspace:*"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "^4.1.5",
    "wouter": "catalog:",
    "zod": "catalog:"
  }
}
