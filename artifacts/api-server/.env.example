# ── Required secrets ──────────────────────────────────────────────────────────

# Legacy kit purchase-webhook (header-match secret, used by TSP Stripe integration)
KIT_WEBHOOK_SECRET=

# Zaprite Bitcoin payment webhook (HMAC-SHA256 secret from the Zaprite dashboard)
# Set this to the signing secret shown in Zaprite → Settings → Webhooks.
# The endpoint to register in Zaprite is: POST /api/kits/zaprite-webhook
ZAPRITE_WEBHOOK_SECRET=

# Stripe secret key (used for kit publishing — Stripe Connect)
STRIPE_SECRET_KEY=

# API base URL (used to construct magic-link access URLs in delivery emails)
# Production: https://your-deployed-domain.replit.app
# Omit in dev — falls back to REPLIT_DEV_DOMAIN automatically
API_BASE_URL=

# Nursery cookie secret (required in production)
NURSERY_COOKIE_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Library owner token (North Star / GORD widget auth)
LIBRARY_OWNER_TOKEN=
